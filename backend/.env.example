# Copy values into your shell environment. No .env loader is required or used.
HOST=127.0.0.1
PORT=8787
# For a deployed service, set the exact browser-facing HTTPS origin.
# PUBLIC_ORIGIN=https://care.example.org
# NODE_ENV=production
# DATA_DIR=/var/lib/melo
# Local Ollama vision model. Only loopback URLs are accepted; photos never go to hosted AI.
MOTOR_ML_URL=http://127.0.0.1:11434/api/chat
MOTOR_ML_MODEL=gemma3:4b
MOTOR_ML_TIMEOUT_MS=300000
