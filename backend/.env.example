# Copy values into your shell environment. No .env loader is required or used.
HOST=127.0.0.1
PORT=8787
# For a deployed service, set the exact browser-facing HTTPS origin.
# PUBLIC_ORIGIN=https://care.example.org
# NODE_ENV=production
# DATA_DIR=/var/lib/melo
# Choose ollama (local) or groq (hosted, requires separate parent permission).
MOTOR_ML_PROVIDER=ollama
# Local Ollama settings. Unset MOTOR_ML_MODEL to use each provider's default.
MOTOR_ML_URL=http://127.0.0.1:11434/api/chat
# MOTOR_ML_MODEL=gemma3:4b
MOTOR_ML_TIMEOUT_MS=300000

# Optional local whisper.cpp server /inference endpoint (never a hosted URL).
# Start the recognizer with a model and language appropriate for the child.
# Unset SPEECH_ML_URL keeps original delivery and therapist assessment available.
SPEECH_ML_PROVIDER=local
# SPEECH_ML_URL=http://127.0.0.1:8080/inference
# SPEECH_ML_MODEL=whisper-small
# SPEECH_ML_LANGUAGE=en
# SPEECH_ML_TIMEOUT_MS=15000
# Audio is resampled locally for recognition. ffmpeg must be installed.
# SPEECH_ML_FFMPEG_PATH=ffmpeg

# Hosted alternative, server only. Use a provider account with suitable data controls.
# Set BOTH provider variables to groq and supply GROQ_API_KEY through a secret store.
# GROQ_API_KEY=
# MOTOR_ML_PROVIDER=groq
# SPEECH_ML_PROVIDER=groq
# Defaults when model variables are unset: qwen/qwen3.8-27b and whisper-large-v3.
# MOTOR_ML_MODEL=qwen/qwen3.8-27b
# SPEECH_ML_MODEL=whisper-large-v3
# Free quotas are limited; a key does not guarantee free or unlimited usage.

# Gemini alternative for drawing photos only; speech then stays local. Parents
# grant online analysis separately for Gemini. Default model: gemini-3.8-flash.
# GEMINI_API_KEY=
# MOTOR_ML_PROVIDER=gemini
# Parents separately enable optional online analysis from their child's dashboard.
# No hosted request is made without that current provider-specific permission.

# Production: separate base64-encoded 32-byte encryption keys from a secret store.
# EXPRESSIONS_KEY defaults to USEFUL_WORDS_KEY when omitted.
# USEFUL_WORDS_KEY=
# EXPRESSIONS_KEY=
