<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the full Melo logo on the page colour. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_logo</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/paper</item>
    </style>
</resources>
